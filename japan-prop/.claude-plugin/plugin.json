{
  "name": "japan-prop",
  "version": "1.0.0",
  "description": "日本の不動産・賃貸探し。スーモ・ヤフー不動産・ニフティ不動産の賃貸・売買物件を横断検索して名寄せし、ハザードマップ・周辺施設・利回りなどを調べる MCP サーバー。ポータルに載らない非公開物件（不動産事業者のみ閲覧可）は対象外",
  "author": {
    "name": "msandroid"
  },
  "repository": "https://github.com/msandroid/Finder",
  "license": "MIT",
  "keywords": [
    "real-estate",
    "rental",
    "chintai",
    "japan",
    "suumo",
    "mcp"
  ],
  "mcpServers": {
    "jp-property-finder": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "mcp_server.py"
      ]
    }
  }
}
